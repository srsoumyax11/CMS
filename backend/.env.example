# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:54322/postgres"

# JWT Security
JWT_SECRET_KEY="generate-a-strong-secret-key-here-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080

# Supabase Storage Integration
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="your-supabase-service-role-key"

# Initial SuperAdmin Credentials (Used during database seeding)
SUPERADMIN_EMAIL="admin@cms.com"
SUPERADMIN_PASSWORD="SuperAdmin@123"

# SMTP / Email Service Configuration (Supabase Local Mailpit: 127.0.0.1:54325)
SMTP_HOST="127.0.0.1"
SMTP_PORT=54325
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER_EMAIL="noreply@cms.com"

# Redis Cache & Rate Limiting
REDIS_URL="redis://127.0.0.1:6379"

# System Environment Mode (dev, staging, prod)
ENVIRONMENT="dev"
